PORT=3001
CLIENT_ORIGIN=http://localhost:5173
DATABASE_URL=postgresql://clinical_pharmacy:change-me@localhost:5432/clinical_pharmacy
DATABASE_POOL_SIZE=10
DATABASE_SSL=false
# Required in production — the server refuses to start without it.
SESSION_SECRET=replace-with-a-long-random-secret
# Web push — optional; unset means notifications are off. Generate once with
# `npx web-push generate-vapid-keys`, and never change them after launch (every subscription
# is tied to the public key). VAPID_SUBJECT is a contact such as mailto:you@example.com.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=
