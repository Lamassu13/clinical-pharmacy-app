{
  "name": "clinical-pharmacy-app",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "vite",
    "server": "node server/index.js",
    "server:dev": "node --watch server/index.js",
    "db:init": "node server/migrate.js",
    "db:backup": "bash scripts/backup-db.sh",
    "pretest": "node --env-file-if-exists=.env.test server/migrate.js",
    "test": "node --env-file-if-exists=.env.test --test --test-concurrency=1 server/*.test.js",
    "create-admin": "node server/create-admin.js",
    "reset-admin": "node server/reset-admin.js",
    "build": "vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{js,jsx}": "oxlint"
  },
  "dependencies": {
    "@fontsource/ibm-plex-sans-arabic": "^5.3.0",
    "bcryptjs": "^3.0.3",
    "connect-pg-simple": "^10.0.0",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "express-rate-limit": "^7.5.1",
    "express-session": "^1.19.0",
    "helmet": "^8.3.0",
    "pg": "^8.23.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.1.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.4.1",
    "oxlint": "^1.79.0",
    "vite": "^8.2.2"
  }
}
